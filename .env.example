# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase
# (Supabase Dashboard → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SOLO SERVIDOR. Nunca la expongas con prefijo NEXT_PUBLIC_.
# Se usa para invitar personal y enviar recordatorios automáticos.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secreto para el endpoint de recordatorios programados (Vercel Cron / cron externo)
CRON_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
