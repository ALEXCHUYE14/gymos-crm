# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase
# (Supabase Dashboard → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://sbbeoqjaflizopsqdhfb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_jZNvez3QqgrxwSJGwcGZKw_E7xKuEHG

# SOLO SERVIDOR. Nunca la expongas con prefijo NEXT_PUBLIC_.
# Se usa para invitar personal y enviar recordatorios automáticos.
# Debe ser la clave "service_role" (Supabase → Project Settings → API), NO la "anon".
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# Secreto para el endpoint de recordatorios programados (Vercel Cron / cron externo)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NUNCA pongas el valor real aquí: este archivo se sube a GitHub.
CRON_SECRET=genera-un-valor-aleatorio-de-al-menos-32-caracteres
